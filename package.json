{
  "name": "metis-agent",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "dev:react": "vite",
    "dev:electron": "wait-on http://localhost:3000 && electron .",
    "dev:clean": "node scripts/kill-stale-electron.js",
    "whisper:prepare": "node scripts/prepare-whisper.js",
    "dev": "npm run dev:clean && npm run whisper:prepare && npx kill-port 3000 && concurrently \"npm run dev:react\" \"npm run dev:electron\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "build:app": "vite build",
    "package": "npm run whisper:prepare && electron-builder",
    "package:win": "node scripts/prepare-whisper.js --platform win32 --arch x64 && electron-builder --win --x64",
    "package:mac": "node scripts/prepare-whisper.js --platform darwin && electron-builder --mac",
    "package:mac:arm64": "node scripts/prepare-whisper.js --platform darwin --arch arm64 && electron-builder --mac --arm64",
    "dist": "vite build && npm run package",
    "dist:win": "vite build && npm run package:win",
    "dist:mac": "vite build && npm run package:mac",
    "dist:mac:arm64": "vite build && npm run package:mac:arm64"
  },
  "build": {
    "appId": "com.fbsis.metis",
    "productName": "Metis",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*",
      "prompts/**/*",
      "main.js",
      "preload.js",
      "translation-worker.js",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/whisper",
        "to": "whisper"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable",
        "zip"
      ],
      "icon": "public/icon/metis-icon.ico"
    },
    "portable": {
      "artifactName": "Metis-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Metis-Setup-${version}.exe"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/icon/icon.png"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "figlet": "^1.11.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "to-ico": "^1.1.5",
    "vite": "^8.0.11",
    "vitest": "^4.1.6",
    "wait-on": "^9.0.5"
  },
  "dependencies": {
    "axios": "^1.16.0",
    "electron-log": "^5.4.4",
    "lucide-react": "^1.14.0",
    "react-hotkeys-hook": "^5.3.2",
    "react-markdown": "^10.1.0",
    "recordrtc": "^5.6.2",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "turndown": "^7.2.4",
    "ws": "^8.20.0"
  }
}
